{
  // The tester's end-to-end test reaches the Worker's code, which needs the Workers types the root config leaves out.
  // Against the built package, as examples/workers/tsconfig.json: CI's example job runs it after pnpm build.
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true, "exactOptionalPropertyTypes": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "paths": { "better-auth-id-jag": ["../../dist/index.d.ts"] }
  },
  "include": ["tester-worker.test.ts", "tester-load.test.ts", "tester-flow.test.ts", "../support/env.d.ts"]
}
