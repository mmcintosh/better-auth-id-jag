{
  "name": "better-auth-id-jag",
  "version": "0.0.0",
  "private": true,
  "description": "Identity Assertion JWT Authorization Grants (ID-JAG, Cross App Access, MCP Enterprise-Managed Authorization) for Better Auth: issue them from your IdP, accept them at your MCP server.",
  "license": "MIT",
  "author": "Mark McIntosh",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint --error-on-warnings",
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.7.5 <1.8.0",
    "@better-auth/oauth-provider": ">=1.7.5 <1.8.0",
    "better-auth": ">=1.7.5 <1.8.0"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/cimd": "1.7.6",
    "@better-auth/core": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "26.6.4",
    "better-auth": "1.7.6",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
