{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "idjag-tester",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "alias": { "better-auth-id-jag": "../../../src/index.ts" },
  "d1_databases": [{ "binding": "DB", "database_name": "idjag-tester", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID", "migrations_dir": "migrations" }],
  // Per-minute limits, per Cloudflare location (approximate). The daily limits are in src/index.ts (LIMITS).
  "ratelimits": [
    { "name": "TOKEN_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "IP_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } }
  ],
  // The purge: ended registrations' clients, users, reports and logs.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "TESTER_ENABLED": "true",
    // Cloudflare's Turnstile test key (always passes); a real deployment uses its own widget's site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_YOUR_GITHUB_OAUTH_APP_CLIENT_ID"
  }
  // Secrets: BETTER_AUTH_SECRET, GITHUB_CLIENT_SECRET, TURNSTILE_SECRET_KEY, ADMIN_STATS_KEY, ADMIN_CLOSE_KEY,
  // ADMIN_OPEN_KEY (each admin key at least 32 characters).
}
